        <mxCell id="15" value="Conv1D (64, k=15)&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;BN + ReLU + MaxPool (2)&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EEE7F5;strokeColor=#9079AF;strokeWidth=1;align=center;verticalAlign=middle;fontFamily=Times New Roman;fontSize=10;fontColor=#252A2E;" vertex="1" parent="1"><mxGeometry x="290" y="330" width="150" height="50" as="geometry" /></mxCell>
