        <mxCell id="4" value="&lt;b&gt;Charging-feature sequence&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Xᵢ,ₜ ∈ R⁴⁰×¹⁴&lt;br&gt;40 cycles × 14 features&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F7FAFC;strokeColor=#8697A8;strokeWidth=1.1;align=center;verticalAlign=middle;fontFamily=Times New Roman;fontSize=12;fontColor=#252A2E;" vertex="1" parent="1"><mxGeometry x="65" y="150" width="190" height="100" as="geometry" /></mxCell>
