        <mxCell id="18" value="&lt;b&gt;Multi-scale feature fusion&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Concatenate: 3×(10×64) → 10×192&lt;br&gt;1×1 Conv, 192→128 + BN + ReLU&lt;br&gt;Output: 10×128&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#E8EFF7;strokeColor=#587DA7;strokeWidth=1.1;align=center;verticalAlign=middle;fontFamily=Times New Roman;fontSize=12;fontColor=#252A2E;" vertex="1" parent="1"><mxGeometry x="710" y="165" width="210" height="140" as="geometry" /></mxCell>
        <mxCell id="19" value="&lt;b&gt;Two-layer LSTM&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Temporal length: 10&lt;br&gt;Hidden units: 64&lt;br&gt;Dropout: 0.4&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF5D7;strokeColor=#C6A24A;strokeWidth=1.1;align=center;verticalAlign=middle;fontFamily=Times New Roman;fontSize=12;fontColor=#252A2E;" vertex="1" parent="1"><mxGeometry x="980" y="165" width="185" height="140" as="geometry" /></mxCell>
        <mxCell id="20" value="&lt;b&gt;Regression head&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Final hidden state&lt;br&gt;FC (64) → ReLU&lt;br&gt;Dropout (0.4) → Sigmoid&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FBEBD9;strokeColor=#D28B42;strokeWidth=1.1;align=center;verticalAlign=middle;fontFamily=Times New Roman;fontSize=12;fontColor=#252A2E;" vertex="1" parent="1"><mxGeometry x="1225" y="165" width="190" height="140" as="geometry" /></mxCell>
        <mxCell id="21" value="&lt;b&gt;ŷᵢ,ₜ&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Predicted SOH&lt;br&gt;ŷᵢ,ₜ ∈ (0, 1)&lt;/font&gt;" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#F4F5F7;strokeColor=#555E68;strokeWidth=1.1;align=center;verticalAlign=middle;fontFamily=Times New Roman;fontSize=13;fontColor=#252A2E;" vertex="1" parent="1"><mxGeometry x="1480" y="180" width="180" height="110" as="geometry" /></mxCell>
        <mxCell id="22" value="&lt;b&gt;Retained SOH targets&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;yᵢ,ₜ = min(Qᵢ,ₜ / Qᵢ,₀, 1)&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF3E8;strokeColor=#D98936;strokeWidth=1;align=center;verticalAlign=middle;fontFamily=Times New Roman;fontSize=10;fontColor=#252A2E;" vertex="1" parent="1"><mxGeometry x="90" y="520" width="220" height="65" as="geometry" /></mxCell>
        <mxCell id="23" value="&lt;b&gt;Mask&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px&quot;&gt;mᵢ,ₜ ∈ {0,1}&lt;br&gt;labelled endpoints only&lt;/font&gt;" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF3E8;strokeColor=#D98936;strokeWidth=1;align=center;verticalAlign=middle;fontFamily=Times New Roman;fontSize=10;fontColor=#252A2E;" vertex="1" parent="1"><mxGeometry x="90" y="605" width="220" height="65" as="geometry" /></mxCell>
