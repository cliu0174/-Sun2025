{
  "model_type": "CNN",
  "model_name": "Convolutional Neural Network",
  
  "architecture": {
    "input_size": -1,
    "num_filters": 64,
    "kernel_size": 3,
    "fc_hidden_sizes": [32, 16],
    "dropout_rate": 0.2,
    "activation": "ReLU",
    "output_activation": "Sigmoid"
  },
  
  "training": {
    "num_epochs": 2500,
    "batch_size": 64,
    "learning_rate": 0.001,
    "optimizer": "Adam",
    "loss_function": "MSELoss",
    "early_stopping": {
      "enabled": false,
      "patience": 100,
      "min_delta": 1e-5
    }
  },
  
  "data": {
    "train_ratio": 0.75,
    "shuffle": true,
    "normalize_target": true
  },
  
  "feature_selection": {
    "enabled": true,
    "correlation_threshold": 0.5
  },
  
  "regularization": {
    "l1_weight": 0.0,
    "l2_weight": 0.0
  },
  
  "description": "一维卷积神经网络。将特征序列当作信号处理，包含卷积层和全连接层。"
}
