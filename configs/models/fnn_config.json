{
  "model_type": "FNN",
  "model_name": "Feedforward Neural Network",

  "architecture": {
    "input_size": -1,
    "hidden_sizes": [64, 32, 16],
    "dropout_rate": 0.2,
    "activation": "ReLU",
    "output_activation": "Sigmoid"
  },

  "training": {
    "num_epochs": 2500,
    "batch_size": 64,
    "learning_rate": 0.0001,
    "optimizer": "Adam",
    "loss_function": "MSELoss",
    "scheduler": {
      "enabled": false,
      "type": "StepLR",
      "step_size": 500,
      "gamma": 0.9
    },
    "early_stopping": {
      "enabled": false,
      "patience": 100,
      "min_delta": 1e-5
    }
  },

  "data": {
    "train_ratio": 0.75,
    "shuffle": true,
    "normalize_target": true
  },

  "feature_selection": {
    "enabled": true,
    "correlation_threshold": 0.5,
    "top_k": 6,
    "method": "correlation"
  },

  "regularization": {
    "l1_weight": 0.0,
    "l2_weight": 0.0
  },

  "description": "简单的前馈神经网络。使用三层隐藏层(64-32-16)，包含ReLU激活和Dropout正则化。"
}
