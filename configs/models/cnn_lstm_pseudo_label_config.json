{
  "model_type": "CNN_LSTM_MC",
  "model_name": "CNN-LSTM + MC Dropout + Pseudo-Labeling (M2+M6)",
  "architecture": {
    "input_size": -1,
    "hidden_size": 64,
    "num_layers": 2,
    "cnn_channels": [256, 128],
    "kernel_size": 7,
    "pool_size": 2,
    "fc_hidden_sizes": [64],
    "dropout_rate": 0.4,
    "activation": "ReLU",
    "output_activation": "Sigmoid"
  },
  "mc_dropout": {
    "enabled": true,
    "n_samples": 50,
    "description": "M2: MCDropout 层，推理时保持激活"
  },
  "training": {
    "num_epochs": 200,
    "batch_size": 256,
    "learning_rate": 0.0005,
    "optimizer": "Adam",
    "loss_function": "MSELoss",
    "scheduler": {
      "enabled": true,
      "type": "WarmupCosineDecay",
      "warmup_epochs": 20,
      "warmup_lr": 0.002,
      "base_lr": 0.005,
      "final_lr": 0.0001
    },
    "early_stopping": {
      "enabled": true,
      "patience": 30,
      "min_delta": 1e-05
    }
  },
  "data": {
    "window_size": 40,
    "train_ratio": 0.75,
    "shuffle": true,
    "normalize_target": true
  },
  "feature_selection": {
    "enabled": true,
    "correlation_threshold": 0.5,
    "top_k": 6,
    "method": "correlation"
  },
  "regularization": {
    "l1_weight": 0.0,
    "l2_weight": 0.0
  },
  "physics_constraints": {
    "enabled": true,
    "base_loss_weight": 1.0,
    "monotonic_weight": 0.1,
    "boundary_weight": 0.05,
    "smoothness_weight": 0.0,
    "monotonic_tolerance": 0.01,
    "temporal_decay": {
      "enabled": true,
      "max_step": 40,
      "decay_type": "exp",
      "decay_alpha": 0.2
    },
    "siamese_sampling": {"enabled": false},
    "triplet_sampling": {"enabled": false},
    "adaptive_weight": {"enabled": false}
  },
  "pseudo_labeling": {
    "enabled": true,
    "warmup_epochs": 30,
    "update_every_k": 5,
    "n_mc_samples": 50,
    "threshold_percentile": 20,
    "max_pseudo_ratio": 0.3,
    "lambda_pseudo": 0.1,
    "epsilon": 1e-6,
    "inference_batch_size": 512,
    "description": "M6: 不确定性引导伪标签。Warmup 30 epoch 后，每 5 epoch 刷新；取不确定性最低 20% 无标签样本为伪标签（保守筛选），lambda=0.1 弱监督附加训练"
  },
  "description": "Exp-06: baseline-v2.2 + M2 MC Dropout + M6 不确定性引导伪标签。核心创新：在部分监督场景下利用高置信度预测扩展监督信号。"
}
