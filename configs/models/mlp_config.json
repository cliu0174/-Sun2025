{
  "model_type": "MLP",
  "model_name": "Multi-Layer Perceptron",

  "architecture": {
    "input_size": -1,
    "hidden_sizes": [60, 60, 60],
    "output_size": 32,
    "dropout_rate": 0.2,
    "activation": "ReLU",
    "output_activation": "Sigmoid"
  },

  "training": {
    "num_epochs": 500,
    "batch_size": 256,
    "learning_rate": 0.0001,
    "optimizer": "Adam",
    "loss_function": "MSELoss",
    "scheduler": {
      "enabled": false,
      "type": "StepLR",
      "step_size": 500,
      "gamma": 0.9
    },
    "early_stopping": {
      "enabled": false,
      "patience": 100,
      "min_delta": 1e-5
    }
  },

  "data": {
    "train_ratio": 0.75,
    "shuffle": true,
    "normalize_target": true
  },

  "feature_selection": {
    "enabled": true,
    "correlation_threshold": 0.5,
    "top_k": 6,
    "method": "correlation"
  },

  "regularization": {
    "l1_weight": 0.0,
    "l2_weight": 0.0
  },

  "description": "多层感知机网络。包含编码器(60-60-60→32)和预测器结构，使用ReLU激活和Sigmoid输出，适用于SOH预测。"
}
