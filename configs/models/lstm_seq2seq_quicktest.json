{
  "model_type": "LSTMSeq2Seq",
  "model_name": "LSTM Sequence-to-Sequence",
  "architecture": {
    "input_size": -1,
    "hidden_size": 64,
    "num_layers": 2,
    "dropout_rate": 0.4,
    "bidirectional": false
  },
  "training": {
    "num_epochs": 2,
    "batch_size": 256,
    "learning_rate": 0.001,
    "optimizer": "Adam",
    "loss_function": "MSELoss",
    "scheduler": {
      "enabled": false,
      "type": "WarmupCosineDecay",
      "warmup_epochs": 30,
      "warmup_lr": 0.002,
      "base_lr": 0.01,
      "final_lr": 0.0001
    },
    "early_stopping": {
      "enabled": false,
      "patience": 50,
      "min_delta": 1e-05
    }
  },
  "data": {
    "window_size": 40,
    "train_ratio": 0.75,
    "shuffle": false,
    "normalize_target": true,
    "output_steps": 20,
    "description": "output_steps: 预测未来多少步的SOH（从window中取后N步作为目标）"
  },
  "feature_selection": {
    "enabled": true,
    "correlation_threshold": 0.5,
    "top_k": 6,
    "method": "correlation"
  },
  "regularization": {
    "l1_weight": 0.0,
    "l2_weight": 0.0
  },
  "physics_constraints": {
    "enabled": true,
    "monotonic_weight": 0.1,
    "boundary_weight": 0.05,
    "smoothness_weight": 0.02,
    "description": "物理约束：monotonic(单调性), boundary(边界[0,1]), smoothness(平滑性)"
  },
  "description": "LSTM Seq2Seq模型。输出整个序列的SOH预测，支持物理约束。"
}