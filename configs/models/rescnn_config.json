{
  "model_type": "ResCNN",
  "model_name": "Residual Convolutional Neural Network",

  "architecture": {
    "input_size": -1,
    "channel_config": [8, 16, 24, 16, 8],
    "stride_config": [1, 2, 2, 1, 1],
    "dropout_rate": 0.5,
    "activation": "ReLU",
    "output_activation": "None"
  },

  "training": {
    "num_epochs": 200,
    "batch_size": 512,
    "learning_rate": 0.002,
    "optimizer": "Adam",
    "loss_function": "MSELoss",
    "scheduler": {
      "enabled": true,
      "type": "WarmupCosineDecay",
      "warmup_epochs": 30,
      "warmup_lr": 0.005,
      "base_lr": 0.01,
      "final_lr": 0.001
    },
    "early_stopping": {
      "enabled": true,
      "patience": 40,
      "min_delta": 1e-5
    }
  },

  "data": {
    "train_ratio": 0.75,
    "shuffle": true,
    "normalize_target": true
  },

  "feature_selection": {
    "enabled": true,
    "correlation_threshold": 0.5,
    "top_k": 6,
    "method": "correlation"
  },

  "regularization": {
    "l1_weight": 0.0,
    "l2_weight": 0.0
  },

  "description": "带残差连接的卷积神经网络。使用ResBlock构建深层网络，通过skip connection缓解梯度消失问题。输出层无激活函数，直接预测容量值。"
}
