{
  "model_type": "CNN_LSTM_MC",
  "model_name": "CNN-LSTM Full Stack (M2+M4+M7)",
  "architecture": {
    "input_size": -1,
    "hidden_size": 64,
    "num_layers": 2,
    "cnn_channels": [256, 128],
    "kernel_size": 7,
    "pool_size": 2,
    "fc_hidden_sizes": [64],
    "dropout_rate": 0.1,
    "activation": "ReLU",
    "output_activation": "Sigmoid"
  },
  "attention": {
    "enabled": false,
    "_disabled_reason": "M1 淘汰：低标签率下有害（稀疏标签导致注意力过拟合）"
  },
  "mc_dropout": {
    "enabled": true,
    "n_samples": 50,
    "description": "M2: 测试时保持 Dropout 激活，50 次采样构建置信区间"
  },
  "training": {
    "num_epochs": 200,
    "batch_size": 1024,
    "learning_rate": 0.0005,
    "optimizer": "Adam",
    "loss_function": "MSELoss",
    "scheduler": {
      "enabled": true,
      "type": "WarmupCosineDecay",
      "warmup_epochs": 20,
      "warmup_lr": 0.002,
      "base_lr": 0.005,
      "final_lr": 0.0001
    },
    "early_stopping": {
      "enabled": true,
      "patience": 30,
      "min_delta": 1e-05
    }
  },
  "data": {
    "window_size": 40,
    "train_ratio": 0.75,
    "shuffle": true,
    "normalize_target": true
  },
  "feature_selection": {
    "enabled": true,
    "correlation_threshold": 0.5,
    "top_k": 6,
    "method": "correlation"
  },
  "regularization": {
    "l1_weight": 0.0,
    "l2_weight": 0.0
  },
  "physics_constraints": {
    "enabled": true,
    "base_loss_weight": 1.0,
    "monotonic_weight": 0.3,
    "boundary_weight": 0.0,
    "smoothness_weight": 0.05,
    "monotonic_tolerance": 0.005,
    "min_cycle": 300,
    "temporal_decay": {
      "enabled": true,
      "max_step": 40,
      "decay_type": "exp",
      "decay_alpha": 0.2
    },
    "siamese_sampling": {"enabled": false},
    "triplet_sampling": {"enabled": false},
    "adaptive_weight": {
      "enabled": false,
      "_disabled_reason": "M5 放弃：log_var 学歪，monotonic 权重持续趋零"
    },
    "description": "M4 速率连续性约束（smoothness_weight=0.05）+ 软单调（w=0.3, tol=0.005, min_cycle=300）"
  },
  "pseudo_labeling": {
    "enabled": false,
    "_disabled_reason": "M6 不进 Full Stack：r<=0.5 不稳定，仅 r=1.0 有效（见 docs/m6_verification_final_20260429.md）"
  },
  "description": "Exp-07 Full Stack（最终版）: M2 MC Dropout + M4 速率连续性 + M7 置信区间评估。不含 M1/M5/M6（已淘汰或适用范围受限）。"
}
