{
  "model_type": "CNN_LSTM_MC",
  "model_name": "CNN-LSTM Full Stack (M1+M2+M4+M5+M6+M7)",
  "architecture": {
    "input_size": -1,
    "hidden_size": 64,
    "num_layers": 2,
    "cnn_channels": [256, 128],
    "kernel_size": 7,
    "pool_size": 2,
    "fc_hidden_sizes": [64],
    "dropout_rate": 0.4,
    "activation": "ReLU",
    "output_activation": "Sigmoid"
  },
  "attention": {
    "enabled": true,
    "num_heads": 4,
    "dropout": 0.1,
    "description": "M1: 循环级 Multi-Head Self-Attention，聚焦退化敏感历史区间"
  },
  "mc_dropout": {
    "enabled": true,
    "n_samples": 50,
    "description": "M2: 测试时保持 Dropout 激活，50 次采样构建置信区间"
  },
  "training": {
    "num_epochs": 200,
    "batch_size": 256,
    "learning_rate": 0.0005,
    "optimizer": "Adam",
    "loss_function": "MSELoss",
    "scheduler": {
      "enabled": true,
      "type": "WarmupCosineDecay",
      "warmup_epochs": 20,
      "warmup_lr": 0.002,
      "base_lr": 0.005,
      "final_lr": 0.0001
    },
    "early_stopping": {
      "enabled": true,
      "patience": 20,
      "min_delta": 1e-05
    }
  },
  "data": {
    "window_size": 40,
    "train_ratio": 0.75,
    "shuffle": true,
    "normalize_target": true
  },
  "feature_selection": {
    "enabled": true,
    "correlation_threshold": 0.5,
    "top_k": 6,
    "method": "correlation"
  },
  "regularization": {
    "l1_weight": 0.0,
    "l2_weight": 0.0
  },
  "physics_constraints": {
    "enabled": true,
    "base_loss_weight": 1.0,
    "monotonic_weight": 1.0,
    "boundary_weight": 1.0,
    "smoothness_weight": 1.0,
    "monotonic_tolerance": 0.01,
    "temporal_decay": {
      "enabled": true,
      "max_step": 40,
      "decay_type": "exp",
      "decay_alpha": 0.2
    },
    "siamese_sampling": {"enabled": false},
    "triplet_sampling": {"enabled": false},
    "adaptive_weight": {
      "enabled": true,
      "l2_reg": 0.01,
      "init_log_vars": [0.0, 0.0, 0.0, 0.0],
      "description": "M5: 可学习 log_vars 自适应平衡 [base, monotonic, boundary, smoothness]"
    },
    "description": "M4+M5: 速率连续性约束 + 自适应损失权重全组合"
  },
  "pseudo_labeling": {
    "enabled": true,
    "warmup_epochs": 30,
    "update_every_k": 5,
    "n_mc_samples": 50,
    "threshold_percentile": 30,
    "max_pseudo_ratio": 0.5,
    "lambda_pseudo": 1.0,
    "epsilon": 1e-6,
    "inference_batch_size": 512,
    "description": "M6: Warmup 30 epoch 后每 5 epoch 刷新伪标签，取不确定性最低 30% 无标签样本"
  },
  "description": "Exp-07 Full Stack: M1 循环级注意力 + M2 MC Dropout + M4 速率连续性 + M5 自适应权重 + M6 伪标签 + M7 置信区间评估。论文最终方法。"
}
